# Settings for the live server, kept at /opt/innerpause/.env (mode 600).
# Every setting is explained in backend/.env.example and docs/LAUNCH.md.

APP_URL=https://theinnerpause.com
NEXT_PUBLIC_APP_URL=https://theinnerpause.com
FRONTEND_ORIGIN=https://theinnerpause.com
# The frontend forwards /api/* to the backend on the same server.
API_URL=http://127.0.0.1:4000
PORT=4000

MONGODB_URI=
# A long random string: openssl rand -hex 32
AUTH_SECRET=
ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# The server's IAM role (innerpause-ec2) grants access; no keys needed.
S3_BUCKET=theinnerpause-files-735381631291
S3_REGION=ap-south-1
S3_PREFIX=inner-pause/

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Inner Pause <no-reply@theinnerpause.com>"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
