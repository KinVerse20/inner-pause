PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/innepause
AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated emails allowed into /admin (sound uploads, card sounds, courses).
ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Going live (see docs/LAUNCH.md) ---
# Public address of the app, used in password reset links.
APP_URL=http://localhost:3000

# Password reset emails, over SMTP (Amazon SES, Resend, Postmark, Gmail...).
# Until SMTP_HOST and MAIL_FROM are set, a live server says reset by email
# isn't available; in development the link is written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Inner Pause <no-reply@example.com>"

# Inner Pause Pass payments (Razorpay Dashboard -> Account & Settings -> API keys).
# rzp_test_ keys take test payments; rzp_live_ keys take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: URL https://<your-domain>/api/pass/webhook,
# events payment.captured and order.paid, with this secret.
RAZORPAY_WEBHOOK_SECRET=

# Sound storage. Leave S3_BUCKET empty to keep files on this server's disk.
# On AWS, give the server an IAM role with s3:GetObject, PutObject,
# DeleteObject and ListBucket on the bucket; no keys needed then.
S3_BUCKET=
S3_REGION=ap-south-1
S3_PREFIX=inner-pause/
# Only for non-AWS S3-compatible storage (Cloudflare R2, MinIO):
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
